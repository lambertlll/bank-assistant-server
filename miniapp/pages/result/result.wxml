<!--pages/result/result.wxml-->
<view class="container">
  <view class="card">
    <view class="title">分析结果</view>
    
    <view wx:if="{{loading}}" class="loading">
      <text>加载中...</text>
    </view>
    
    <view wx:elif="{{error}}" class="error">
      {{error}}
    </view>
    
    <view wx:else class="result-content">
      <text>{{result}}</text>
    </view>
  </view>
  
  <view class="actions">
    <button class="button-secondary" bindtap="copyResult">复制结果</button>
    <button class="button-primary" bindtap="backToHome">返回首页</button>
  </view>
</view>
