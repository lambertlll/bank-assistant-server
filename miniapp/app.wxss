/**app.wxss**/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.container {
  padding: 20rpx;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.button-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.button-primary:active {
  opacity: 0.8;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.error {
  color: #ff4d4f;
  padding: 20rpx;
  background-color: #fff2f0;
  border-radius: 8rpx;
  margin-top: 20rpx;
}
